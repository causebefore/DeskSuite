# 菜单标题保持 ASCII，兼容 esp-sr 在 Windows 上按系统代码页读取 sdkconfig。
menu "Communication - Connect"

    config COMMUNICATION_TASK_STACK_STATS
        bool "输出 Communication 后台任务栈统计"
        default n
        help
            定期输出共享 Communication 组件内部 Task 的栈余量。
            仅建议在提供 task_stack_stats 的产品诊断构建中启用。

    config CONNECT_PORTAL_SSID
        string "Portal 热点名称"
        default "Device-Setup"
        help
            配网 Portal 使用的 Wi-Fi 热点名称，长度必须为 1 至 32 字节。
            产品应在项目级 sdkconfig.defaults 中覆盖该通用默认值。

    config CONNECT_PORTAL_PASSWORD
        string "Portal 热点密码"
        default "configureme"
        help
            配网 Portal 使用的 WPA/WPA2 密码，长度必须为 8 至 63 字节。
            产品应在项目级 sdkconfig.defaults 中覆盖该通用默认值。

    config CONNECT_PORTAL_DEFAULT_SERVICE_URL
        string "Portal 默认服务地址"
        default ""
        help
            配网 Portal 表单中「服务地址」字段的默认值。
            可以填写完整 http(s) URL，也可以填写 host:port，例如
            http://192.168.1.100:8765 或 192.168.1.100:8765。
            留空则 Portal 表单该字段为空，等待用户手动填写。

endmenu
