CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_DEBUG=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=100
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_DESKMATE_SERVER_URL="http://192.168.6.248:8765"
CONFIG_CONNECT_PORTAL_SSID="DeskMate-Setup"
CONFIG_CONNECT_PORTAL_PASSWORD="deskmate"
CONFIG_CONNECT_PORTAL_DEFAULT_SERVICE_URL="http://192.168.6.248:8765"
CONFIG_NETWORK_MANAGER_DEFAULT_SERVICE_URL="http://192.168.6.248:8765"
CONFIG_COMMUNICATION_HTTP_TIMING_LOGS=n
CONFIG_COMMUNICATION_TASK_STACK_STATS=y
CONFIG_DESKMATE_OTA_AUTO_INSTALL=y
CONFIG_DESKMATE_OTA_CHECK_INTERVAL_SEC=1800
CONFIG_DESKMATE_WAKE_WORD_ENABLE=n
CONFIG_DESKMATE_LIGHT_SLEEP_ENABLED=y
CONFIG_DESKMATE_LIGHT_SLEEP_IDLE_TIMEOUT_SEC=60
CONFIG_DESKMATE_LIGHT_SLEEP_RETRY_DELAY_MS=10000
CONFIG_DESKMATE_LIGHT_SLEEP_REFRESH_INTERVAL_SEC=60
CONFIG_DESKMATE_RTC_ALARM_MAX_DELAY_SEC=86400
CONFIG_DESKMATE_WIFI_RECONNECT_BACKOFF_MIN_MS=30000
CONFIG_DESKMATE_WIFI_RECONNECT_BACKOFF_MAX_MS=300000
CONFIG_DESKMATE_API_HTTP_TIMEOUT_MS=20000
CONFIG_DESKMATE_API_SYNC_RETRY_MAX=3
CONFIG_DESKMATE_API_SYNC_RETRY_DELAY_MS=5000
CONFIG_DESKMATE_API_DEFAULT_REFRESH_SEC=300
CONFIG_DESKMATE_API_DASHBOARD_JSON_MAX=12288
CONFIG_DESKMATE_OTA_HTTP_TIMEOUT_MS=8000
CONFIG_DESKMATE_DASHBOARD_REFRESH_DEFAULT_SEC=1800
CONFIG_DESKMATE_SETTINGS_NAMESPACE="deskmate"
CONFIG_DESKMATE_INPUT_DEBOUNCE_MS=30
CONFIG_DESKMATE_INPUT_LONG_PRESS_MS=700
CONFIG_DESKMATE_INPUT_POLL_PERIOD_MS=10
CONFIG_DESKMATE_AUDIO_DEFAULT_VOLUME=50
CONFIG_DESKMATE_AUDIO_DEFAULT_GAIN_DB=30
CONFIG_DESKMATE_VOICE_HTTP_TIMEOUT_MS=30000
CONFIG_DESKMATE_VOICE_VAD_LEAD_TIMEOUT_MS=3000
CONFIG_DESKMATE_VOICE_VAD_SILENCE_END_MS=1200
CONFIG_DESKMATE_VOICE_VAD_WAKE_GUARD_MS=500
CONFIG_DESKMATE_VOICE_PLAYBACK_STOP_TIMEOUT_MS=3000
CONFIG_DESKMATE_VOICE_WS_CONNECT_TIMEOUT_MS=5000
CONFIG_DESKMATE_VOICE_WS_IDLE_TIMEOUT_MS=30000
CONFIG_DESKMATE_VOICE_WS_RX_QUEUE_LEN=64
CONFIG_DESKMATE_VOICE_WS_BUFFER_SIZE=24576
CONFIG_DESKMATE_VOICE_WS_UPLOAD_CHUNK_BYTES=4096
CONFIG_DESKMATE_VOICE_PLAY_STREAM_BYTES=262144
CONFIG_DESKMATE_VOICE_CHAT_DURATION_MS=8000
CONFIG_DESKMATE_VOICE_WAKE_COOLDOWN_MS=2000
CONFIG_DESKMATE_AUDIO_SPEECH_MIN_MS=200
CONFIG_DESKMATE_AUDIO_DRAIN_MAX_WAIT_MS=300
CONFIG_DESKMATE_DISPLAY_PARTIAL_FLUSH=y
CONFIG_DESKMATE_DISPLAY_PARTIAL_FULL_PERCENT=70
CONFIG_DESKMATE_DISPLAY_TE_SYNC=y
CONFIG_DESKMATE_DISPLAY_TE_WAIT_TIMEOUT_MS=60
CONFIG_DESKMATE_DISPLAY_TE_MAX_TIMEOUTS=5
CONFIG_DESKMATE_DISPLAY_RGB565_BLACK_THRESHOLD=6368
CONFIG_DESKMATE_DISPLAY_I1_INVERT=n
CONFIG_DESKMATE_DISPLAY_PERF_LOG_INTERVAL_US=5000000
CONFIG_DESKMATE_UI_PAGE_ENTER_ANIM_MS=200
CONFIG_DESKMATE_UI_SETTINGS_RESULT_AUTO_RETURN_MS=3000
CONFIG_DESKMATE_UI_TASK_STACK_SIZE=8192
CONFIG_PM_ENABLE=y

# 网页文件管理：支持 UTF-8 长文件名，并为最坏百分号编码后的路径保留 URI 空间
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
# CONFIG_FATFS_API_ENCODING_ANSI_OEM is not set
# CONFIG_HTTPD_WS_SUPPORT is not set
CONFIG_HTTPD_MAX_URI_LEN=2048

# remote_log 通过 Log V2 包装普通 ESP_LOGx 并上传网络日志
CONFIG_LOG_VERSION_2=y
CONFIG_LOG_MODE_TEXT=y


# 外置sram相关配置
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# 低性能内部 SRAM 档：缩小 Data Cache，并把非 Cache-off 必需路径放回 Flash
CONFIG_ESP32S3_DATA_CACHE_16KB=y
CONFIG_ESP32S3_DATA_CACHE_32KB=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=n
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n

# ESP-IDF v6.0.1 的按任务堆跟踪在 realloc/free 路径存在已知一致性问题，仅保留总量统计
# CONFIG_HEAP_TASK_TRACKING is not set

# mbedTLS 上下文、证书与收发工作内存优先放入 PSRAM，保留内部 RAM 给 DMA 和任务栈
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y


# lvgl 相关配置
CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_ASSERT_STYLE=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CALENDAR_HEADER_ARROW=n
CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=y
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_DEF_REFR_PERIOD=10
CONFIG_SPIRAM_SPEED_80M=y

# 音频 codec 支持（esp_codec_dev 组件 Kconfig，clean build 时需显式指定）
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=y

# ESP-SR 声学前端模型（esp-sr 组件 Kconfig）
CONFIG_MODEL_IN_FLASH=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_SR_NSN_NSNET2=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
# WiFi 低吞吐内存档：PSRAM 优先分配会强制使用静态 TX，因此降低池数量而不切换动态 TX
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=n
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
