# 密钥示例文件。
# 复制为 .env 后填写真实值；所有非密钥配置请改 config.toml。
# RSS 不需要密钥，订阅地址统一配置在 config.toml 的 [rss].feeds。
# 设备每日唤醒时间配置在 config.toml 的 [display.refresh_schedule].daily_times。

# 和风天气 API Key。天气与月相共用；为空时服务会自动返回 mock 数据。
QWEATHER_API_KEY=replace-with-your-qweather-api-key

# 智谱开放平台 API Key。同时供语音（ASR/LLM/TTS）与长期记忆（mem0 抽取/embedding）复用。
# 获取地址：https://open.bigmodel.cn/ → 控制台 → API Keys
ZHIPU_API_KEY=

# iCloud CalDAV（日程）。用户名是 Apple ID 邮箱；密码是 appleid.apple.com 生成的「应用专用密码」，非 Apple ID 密码。
CALDAV_USERNAME=your_apple_id@icloud.com
CALDAV_PASSWORD=replace-with-app-specific-password

# foxmail IMAP（只读收件）。用户名是完整 foxmail 地址；密码是 QQ 邮箱设置里生成的「授权码」，非 QQ 密码。
IMAP_USERNAME=lbq08@foxmail.com
IMAP_PASSWORD=replace-with-foxmail-auth-code

# 设备访问语音和显示接口时使用的共享 Token。留空表示局域网开发期不鉴权。
DEVICE_API_TOKEN=
