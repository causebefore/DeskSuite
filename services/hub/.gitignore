firmwares/artifacts/*.bin
firmwares/manifests/*.json
!firmwares/manifests/*.example.json

# 本机工具状态
.idea/
.codegraph/

# Superpowers SDD scratch（任务 brief / report / review diff，不入库）
.superpowers/

debug_audio/
